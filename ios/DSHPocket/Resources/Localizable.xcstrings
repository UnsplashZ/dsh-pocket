      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone and computer talk over encrypted peer-to-peer iroh. When hole-punching succeeds nothing goes through a third party; on relay fallback the relay only sees ciphertext."
