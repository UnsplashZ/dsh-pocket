          "stringUnit": {
            "state": "translated",
            "value": "If this is the first launch after installing, check Settings → Privacy & Security → Local Network and make sure DSH Pocket is allowed — with it off, iOS silently drops packets and it looks like “connecting” forever."
          }
        }
      }
